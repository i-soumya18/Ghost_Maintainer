# Ghost Maintainer Environment Configuration
# Default backend: unsloth (open weights), openai_compat, or mock (testing)
GHOST_BACKEND=unsloth

# Cache directory for BM25 indices and repository metadata
GHOST_CACHE_DIR=~/.ghost

# Retrieval gate threshold (BM25 score cut-off for silence)
GHOST_MIN_SCORE=0.8

# Server Configuration
GHOST_HOST=127.0.0.1
GHOST_PORT=6660

# Optional: For local OpenAI-compatible server (e.g. Ollama, llama.cpp, LM Studio, vLLM)
# GHOST_BASE_URL=http://localhost:11434/v1
# GHOST_OPENAI_MODEL=qwen3:4b

# Optional: For OpenAI API endpoint (frontier reference baseline)
# OPENAI_API_KEY=sk-...
# GHOST_OPENAI_MODEL=gpt-6-luna
