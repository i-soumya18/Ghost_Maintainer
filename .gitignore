# ==============================================================================
# Ghost Maintainer .gitignore
# ==============================================================================

# --- Byte-compiled / optimized Python files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Distribution / packaging ---
build/
dist/
eggs/
*.egg-info/
*.egg
.installed.cfg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
*.venv/

# --- Ghost Maintainer application caches & local state ---
.ghost/
*.ghost/

# --- Machine Learning checkpoints, models & tracking ---
checkpoints/
models/
data/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
wandb/
mlruns/

# --- Databases & Logs ---
*.db
*.sqlite
*.sqlite3
*.log
logs/

# --- Agent workflows & AI scratchpads ---
.agents/
.gemini/
.antigravity/
ORIGINAL_REQUEST.md

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- Type checking & Linters ---
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# --- Frontend / Web dependencies & builds ---
node_modules/
web/node_modules/
web/dist/
web/.vite/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment variables & secrets ---
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- IDE and Editor configurations ---
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --- Jupyter Notebook checkpoints ---
.ipynb_checkpoints

# --- Operating System artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
